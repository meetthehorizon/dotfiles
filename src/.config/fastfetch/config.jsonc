{
  "display": {
    "color": {
      "keys": "white"
    },
    "key": {
      "width": 14
    },
    "separator": "  "
  },
  "logo": {
    "color": {
      "1": "white"
    },
    "padding": {
      "left": 2,
      "top": 2
    },
    "source": "$HOME/.config/fastfetch/logo.txt",
    "type": "file"
  },
  "modules": [
    {
      "color": {
        "at": "black",
        "host": "red",
        "user": "red"
      },
      "type": "title"
    },
    "break",
    {
      "format": "{pretty-name}",
      "key": "  OS",
      "keyColor": "blue",
      "type": "os"
    },
    {
      "key": " 󰌽 Kernel",
      "keyColor": "magenta",
      "type": "kernel"
    },
    {
      "format": "{pretty-name}",
      "key": "  WM",
      "keyColor": "red",
      "type": "wm"
    },
    {
      "format": "{pretty-name}",
      "key": "  Shell",
      "keyColor": "green",
      "type": "shell"
    },
    {
      "key": " 󰔚 Uptime",
      "keyColor": "yellow",
      "type": "uptime"
    },
    {
      "format": "{used} / {total}",
      "key": "  Ram",
      "keyColor": "blue",
      "type": "memory"
    },
    {
      "format": "{pretty-name}",
      "key": " 󰸱 Color",
      "symbol": "circle",
      "type": "colors"
    }
  ]
}
